# Copy to .env and fill in to enable the REAL cloud tier (Azure AI Foundry / Azure OpenAI).
# If these are left unset, the app SIMULATES the cloud tier with a larger local model
# (still counted as "cloud" data) so the demo works fully offline.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Set true only after authenticating a DefaultAzureCredential source.
AZURE_USE_AAD=false

# Optional overrides
# FOUNDRY_ENDPOINT=http://127.0.0.1:63166
# BRAND_NAME=Use AI in the Right Place
# JUDGE_MODEL=phi-4-mini
# On a CPU-only VM, load that variant and pin its exact API model ID instead:
# JUDGE_MODEL=Phi-4-mini-instruct-generic-cpu
# V2 Judge inference inactivity timeout; no automatic model-request retries.
# JUDGE_TIMEOUT_SECONDS=30
# LOCAL_MODEL=phi-4-mini
# CLOUD_SIM_MODEL=phi-4-mini

# Pi extension settings (set these in the shell that launches Pi)
# RELAYIQ_PI_URL=http://127.0.0.1:8000
# RELAYIQ_PI_LOCAL_MODELS=llama-cpp/phi-4-mini
# RELAYIQ_PI_CLOUD_MODELS=openai/gpt-5.2
# RELAYIQ_PI_TIMEOUT_MS=10000
# RELAYIQ_PI_CLOUD_BUDGET_KB=observed

# Standalone Draft 4 decision API (bundled policy revision: relayiq-judge-v1)
# RELAYIQ_POLICY_CONFIG=C:\path\to\RelayIQ\config\relayiq-policy.json

# Impact meter tuning knobs (used for Saved USD and Saved CO2 estimates)
# EST_USD_PER_KB=0.00008
# EST_USD_PER_CLOUD_REQ=0.0030
# EST_CO2G_PER_KB=0.25
# EST_CO2G_PER_CLOUD_REQ=1.8
# USD_TO_EUR=0.92
